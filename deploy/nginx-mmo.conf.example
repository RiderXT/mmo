# Nginx server block for the MMO. Copy to /etc/nginx/sites-available/mmo on the VPS,
# symlink into sites-enabled, then run certbot to add HTTPS.
#
#   sudo cp deploy/nginx-mmo.conf.example /etc/nginx/sites-available/mmo
#   sudo nano /etc/nginx/sites-available/mmo   # set your (sub)domain below
#   sudo ln -s /etc/nginx/sites-available/mmo /etc/nginx/sites-enabled/mmo
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d gra.twoja-domena.pl
#
# This only adds a NEW server block — it does not touch any other sites already
# configured in /etc/nginx/sites-enabled.

server {
    listen 80;
    listen [::]:80;
    server_name gra.twoja-domena.pl;

    # API + health check → Node process (see deploy/mmo-api.service.example)
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://127.0.0.1:4000;
    }

    # Uploaded item artwork (apps/api/uploads, served by @fastify/static) → Node process.
    # Without this, /uploads/* falls through to the SPA's catch-all below and returns
    # index.html instead of the image (VITE_API_URL is empty in production, so <img src>
    # is a same-origin relative path that only nginx can route correctly).
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else → the built React app (static files)
    root /var/www/mmo/apps/web/dist;
    index index.html;
    location / {
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
