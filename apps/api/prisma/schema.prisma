generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev uses SQLite (zero-install: no enums, no native Json type, so
  // enums and JSON-shaped fields below are plain String columns, serialized
  // by the application layer). Swap to "postgresql" before deploying and
  // these can become native enum + Json columns — see docs/architecture.md.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Valid values (enforced in app code via @mmo/shared zod enums): player | moderator | admin
// Valid values: debug | info | warn | error
// Valid values: in_progress | completed | claimed

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  role              String   @default("player")
  // Bumped fire-and-forget on every authenticated request (see lib/authGuard.ts) — "online" on
  // the profile page is derived from this being within the last few minutes, not a stored flag.
  lastSeenAt        DateTime?
  // When true, isOnline()-derived status (and, in the public profile, the raw lastSeenAt
  // timestamp) is hidden from other players — see modules/profile, modules/friends.
  hideOnlineStatus  Boolean  @default(false)
  // Unique shareable referral code. Nullable (not @default-generated) so this addition doesn't
  // require backfilling existing rows in one migration — new registrations get one assigned
  // explicitly in registerUser; existing accounts get one lazily generated on first access to
  // Account Settings (see modules/account/service.ts). Redeemed via RegisterSchema.referralCode.
  referralCode      String?  @unique
  // Set when the player requests account deletion (GDPR-style, 30-day grace period — see
  // requestAccountDeletion/cancelAccountDeletion/loginUser in modules/auth/service.ts). Null =
  // no deletion pending. The actual hard delete happens lazily on the next login attempt once
  // this is more than 30 days in the past, not via a cron job.
  deletionRequestedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  characters        Character[]
  refreshTokens     RefreshToken[]
  gameLogs          GameLog[]
  friendRequestsSent     FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  referralsMade     Referral[] @relation("ReferralsMade")
  referralReceived  Referral?  @relation("ReferralReceived")
  messagesSent          Message[]             @relation("MessagesSent")
  messagesReceived      Message[]             @relation("MessagesReceived")
  supportTickets        SupportTicket[]
  supportTicketReplies  SupportTicketReply[]
  changelogEntries      ChangelogEntry[]

  @@index([role])
}

// A referral link between two accounts, created at registration when the new user redeemed
// someone else's referralCode. Reward payout (gold/item to referrer and/or referred, per
// admin-configured referral.settings — see settings/service.ts) is deferred until the referred
// character reaches the configured level, tracked by rewardedAt staying null until then — see
// lib/referralRewards.ts's tryPayReferralReward, called at registration (for requiredLevel<=1)
// and on every level-up (expeditions/service.ts).
model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String    @unique
  createdAt   DateTime  @default(now())
  rewardedAt  DateTime?

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// Both a pending invite and an accepted friendship are rows here — "friend" = status "accepted",
// checked from either side (requester or addressee). Unfriend = delete the row.
// Valid values: pending | accepted | declined
model FriendRequest {
  id            String   @id @default(cuid())
  requesterId   String
  addresseeId   String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Character {
  id                 String   @id @default(cuid())
  userId             String
  name               String   @unique
  level              Int      @default(1)
  exp                Int      @default(0)
  gold               Int      @default(0)
  classId            String?
  strength           Int      @default(5)
  vitality           Int      @default(5)
  dexterity          Int      @default(5)
  intelligence       Int      @default(5)
  unspentStatPoints  Int      @default(0)
  unspentSkillPoints Int      @default(0)
  currentZoneId      String?
  activeExpeditionId String?  @unique
  // Travel state — see docs/architecture.md "Etap 9". travelArrivesAt null = not traveling;
  // its presence is the source of truth for "in transit", independent of currentZoneId (which
  // only changes once arrival is resolved). travelDestinationZoneId null while traveling means
  // "heading to the village".
  travelDestinationZoneId String?
  travelArrivesAt         DateTime?
  // Lifetime counters for the public profile page — incremented in applyExpeditionReward
  // (expeditions/service.ts) and openChest (inventory/service.ts) respectively.
  monstersKilled     Int      @default(0)
  chestsOpened       Int      @default(0)
  // Personal, time-limited multipliers granted by using a "buff_exp"/"buff_gold"/"buff_drop"
  // item (potionTrigger "on_use", consumed instantly — see inventory/service.ts useBuffItem).
  // These MULTIPLY with the global GameEvent multiplier, they don't replace it (see
  // lib/personalBuffs.ts, expeditions/service.ts buildAndSimulate). Null/expired "*Until" = no
  // active bonus. Using a new item of the same effect OVERWRITES the previous one (no stacking).
  expBuffMultiplier  Float?
  expBuffUntil       DateTime?
  goldBuffMultiplier Float?
  goldBuffUntil      DateTime?
  dropBuffMultiplier Float?
  dropBuffUntil      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class                 CharacterClass? @relation(fields: [classId], references: [id])
  currentZone           Zone?           @relation("CharacterCurrentZone", fields: [currentZoneId], references: [id])
  travelDestinationZone Zone?           @relation("CharacterTravelDestination", fields: [travelDestinationZoneId], references: [id])
  inventory   InventoryItem[]
  skills      CharacterSkill[]
  skillNodes  CharacterSkillNode[]
  dailyLoginRewards CharacterDailyLoginReward[]
  expeditions Expedition[]    @relation("CharacterExpeditions")
  gatherSession GatherSession?
  passiveSkills CharacterPassiveSkill[]

  @@index([userId])
  @@index([classId])
}

model CharacterClass {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  primaryStat String // CoreStatKey: strength | vitality | dexterity | intelligence
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Granted once, at character creation — see docs/architecture.md.
  startingGold Int @default(0)

  skills       ClassSkill[]
  characters   Character[]
  items        Item[]
  starterItems ClassStarterItem[]
}

model ClassSkill {
  id              String  @id @default(cuid())
  classId         String
  name            String
  description     String  @default("")
  kind            String // "passive" | "active"
  scalingStat     String // CoreStatKey
  scalingFactor   Float   @default(1)
  targetStat      String? // StatKey — passive only
  effectType      String? // SkillEffectType (@mmo/shared enums.ts) — active only
  cooldownSeconds Int? // active only, BASE cooldown (nodes with effect "cooldown" reduce it)
  // unlockCost is the FLAT cost per level (same at every level, like SkillTreeNode.pointCost —
  // not progressive). maxLevel=1 (the default) preserves the original one-shot "unlock" model
  // exactly; raising it lets the skill itself be leveled multiple times, each level beyond 1
  // adding levelMagnitudePct to its own power on top of whatever SkillTreeNode unlocks add.
  // baseManaCost replaces the old global 10+5*level formula for active skills.
  unlockCost        Int   @default(1)
  maxLevel          Int   @default(1)
  levelMagnitudePct Float @default(0) // PER LEVEL beyond 1: +X% power (see gatherCombatBuild)
  baseManaCost      Int? // active only, BASE mana cost (nodes with effect "cost" reduce it)
  // Only meaningful for buff-style effectType (attack_speed/defense/crit/block_chance/reflect) —
  // how long the self-buff lasts once activated. Null = fall back to a fixed default in combat.ts.
  durationSeconds Int?
  category     String @default("combat") // "combat" | "survival" | "tactics" — groups skills into UI tabs
  // Uploaded artwork path (e.g. "/uploads/skills/xxx.png"), served statically like Item.imageUrl
  // — see modules/admin/classes. Null = fall back to the generic SkillSygil placeholder.
  imageUrl String?
  // From this level onward (inclusive), unlockSkill() no longer accepts points — the skill can
  // only keep leveling via successful skill-book reads targeting it (Item.bookClassSkillId), up to
  // maxLevel. Null = no gate, points alone govern all the way to maxLevel exactly as before this
  // field existed (fully backward compatible). Mirrors PassiveSkillType.bookGateFromLevel.
  bookGateFromLevel Int?

  class            CharacterClass             @relation(fields: [classId], references: [id], onDelete: Cascade)
  characterSkills  CharacterSkill[]
  nodes            SkillTreeNode[]
  bookRequirements ClassSkillBookRequirement[]
  books            Item[]                     @relation("BookForClassSkill")

  @@unique([classId, name])
}

// How many successful skill-book reads are required to advance INTO a given level, beyond
// ClassSkill.bookGateFromLevel. No row for a level = falls back to 1 (see
// modules/characters/service.ts readSkillBook). Mirrors PassiveSkillBookRequirement.
model ClassSkillBookRequirement {
  id            String @id @default(cuid())
  classSkillId  String
  level         Int
  booksRequired Int    @default(1)

  classSkill ClassSkill @relation(fields: [classSkillId], references: [id], onDelete: Cascade)

  @@unique([classSkillId, level])
}

// An upgrade unlockable within a ClassSkill's own tree (own node list, not spanning multiple
// skills). requiresNodeId (nullable, within the SAME classSkillId) gates the node behind a
// specific sibling being invested first — NULL means it's a branch root, available as soon as
// the parent ClassSkill itself is unlocked. See modules/characters/service.ts unlockNode.
model SkillTreeNode {
  id             String  @id @default(cuid())
  classSkillId   String
  name           String
  description    String  @default("")
  effect         String // "magnitude" | "cost" | "cooldown" — cost/cooldown only meaningful for kind=active
  magnitudePct   Float // PER LEVEL: e.g. 0.1 = +10% power (magnitude) or -10% cost/cooldown, multiplied by invested level
  pointCost      Int     @default(1) // flat cost per level invested (not progressive)
  maxLevel       Int     @default(1)
  requiresNodeId String?
  // Uploaded artwork path — see ClassSkill.imageUrl above, same convention.
  imageUrl String?

  classSkill       ClassSkill           @relation(fields: [classSkillId], references: [id], onDelete: Cascade)
  requires         SkillTreeNode?       @relation("NodePrerequisite", fields: [requiresNodeId], references: [id], onDelete: SetNull)
  requiredBy       SkillTreeNode[]      @relation("NodePrerequisite")
  characterUnlocks CharacterSkillNode[]

  @@unique([classSkillId, name])
}

model CharacterSkill {
  id           String  @id @default(cuid())
  characterId  String
  classSkillId String
  level        Int     @default(0) // 0 = not invested; 1 == the old `unlocked: true`; up to classSkill.maxLevel
  // Successful skill-book reads accumulated toward the CURRENT target level's requirement
  // (ClassSkillBookRequirement) — resets to 0 on level-up. Only meaningful once level has reached
  // classSkill.bookGateFromLevel - 1. Mirrors CharacterPassiveSkill.pendingBooksRead.
  pendingSkillBooksRead Int @default(0)
  // Running totals of every successfully-read skill book's own fixed bonus for this skill —
  // NOT a per-level formula (unlike levelMagnitudePct): each book grants its own specific amount,
  // accumulated book-by-book regardless of whether that particular read crossed a level threshold.
  // Added into gatherCombatBuild's formulas additively, alongside sumNodePct's node contribution
  // (nodes and books coexist additively — nodes are dormant/unused going forward but their
  // contribution stays wired in, evaluating to 0 when no nodes are configured).
  bookMagnitudePct       Float @default(0) // sum of every successful "magnitude" book's bonus (%)
  bookCostFlatAmount     Float @default(0) // sum of every successful "cost" book's bonus (flat mana)
  bookCooldownFlatAmount Float @default(0) // sum of every successful "cooldown" book's bonus (flat seconds)

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  classSkill ClassSkill @relation(fields: [classSkillId], references: [id], onDelete: Cascade)

  @@unique([characterId, classSkillId])
}

model CharacterSkillNode {
  id          String @id @default(cuid())
  characterId String
  nodeId      String
  level       Int    @default(1) // existing pre-leveling rows meant "unlocked" — level 1 preserves that exactly

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  node      SkillTreeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([characterId, nodeId])
}

// One row per character per calendar day (Europe/Warsaw) — the daily-login reward cycle is
// tracked per CHARACTER, not per account, so two characters on the same user get independent
// streaks/cycles (see modules/dailyLogin).
model CharacterDailyLoginReward {
  id           String    @id @default(cuid())
  characterId  String
  periodKey    String // "YYYY-MM-DD" in Europe/Warsaw
  cycleDay     Int // 1-7, position within the repeating reward cycle
  streak       Int // consecutive-day counter — keeps growing past day 7, resets only on a skipped day
  rewardType   String // "gold" | "exp"
  rewardAmount Int
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, periodKey])
}

// Character-wide passive/profession skills (e.g. "Górnictwo") — unlike ClassSkill these are not
// class-specific and don't cost skill points: they level up only via reading a "book" item with a
// per-read success chance (see Item.bookSkillTypeId/bookSuccessChance, modules/passiveSkills).
model PassiveSkillType {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String   @default("")
  maxLevel            Int      @default(100)
  // Which gathering activity this skill boosts, if any — null = no mechanical effect (yet).
  gatherKind          String? // "fishing" | "mining"
  // Bonus added to that gather kind's success chance PER SKILL LEVEL (0..1 scale, same units as
  // Item.gatherChanceBonusPctMax), stacking additively with the equipped tool's own bonus.
  chanceBonusPerLevel Float    @default(0)
  // Same idea for the phase-duration speed bonus (only applies to catching/extracting, mirroring
  // how the tool's own speed bonus never speeds up the mining "searching" phase).
  speedBonusPerLevel  Float    @default(0)
  // XP-driven leveling for gatherKind skills — see passiveSkills/service.ts's grantGatherXp
  // (called from gathering/service.ts on every catch/dig attempt, success or not) and readBook.
  // Flat curve: always xpPerLevel XP per level, no scaling curve — simple to configure/predict.
  xpPerLevel            Int      @default(100)
  // XP granted per matching gather attempt (not just successful ones).
  xpPerGatherAction     Int      @default(1)
  // From this level onward (inclusive, counting the TARGET level), reaching full XP no longer
  // auto-levels — booksRequiredPerLevel successful book reads (still gated by bookSuccessChance,
  // a book can still be "wasted") are required on top. Null = no gate, pure XP leveling forever.
  bookGateFromLevel     Int?
  // Flat DEFAULT fallback — used for any level with no row in bookRequirements below. Kept as-is
  // so every existing configured skill keeps working unmigrated.
  booksRequiredPerLevel Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  characterSkills  CharacterPassiveSkill[]
  books            Item[]                        @relation("BookForPassiveSkill")
  bookRequirements PassiveSkillBookRequirement[]
}

// Per-level override of PassiveSkillType.booksRequiredPerLevel — no row for a given level falls
// back to that flat default. Mirrors ClassSkillBookRequirement.
model PassiveSkillBookRequirement {
  id            String @id @default(cuid())
  skillTypeId   String
  level         Int
  booksRequired Int

  skillType PassiveSkillType @relation(fields: [skillTypeId], references: [id], onDelete: Cascade)

  @@unique([skillTypeId, level])
}

model CharacterPassiveSkill {
  id          String @id @default(cuid())
  characterId String
  skillTypeId String
  level       Int    @default(0)
  // Progress toward the next level — see PassiveSkillType.xpPerLevel. Carried over (not reset to
  // 0) past a level-up, so surplus XP from a large xpPerGatherAction isn't wasted.
  xp               Int @default(0)
  // Successful book reads accumulated toward the book gate at the CURRENT level — resets on level-up.
  pendingBooksRead Int @default(0)
  // Running totals of every successfully-read gathering book's own fixed bonus — same "book grants
  // its own fixed amount" principle as CharacterSkill above, additive into
  // getPassiveSkillGatherBonus() alongside the existing level*chanceBonusPerLevel/
  // level*speedBonusPerLevel terms (which stay unchanged, driving PRE-gate XP levels only).
  bookChanceBonus Float @default(0)
  bookSpeedBonus  Float @default(0)

  character Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillType PassiveSkillType @relation(fields: [skillTypeId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillTypeId])
}

model Zone {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String   @default("")
  minLevel          Int
  maxLevel          Int
  // Base one-way travel time from the village, in seconds, before movementSpeed reduction.
  travelTimeSeconds Int      @default(30)
  // Town zones have no monsters/combat — the "walcz" flow is replaced by an NPC list (see
  // docs/architecture.md "Etap 21"). Travel to/from a town works exactly like any other zone.
  isTown            Boolean  @default(false)
  // Lets a character enter/use this zone (travel, gathering) even after leveling above
  // maxLevel — e.g. to keep using a fishing spot/mine after outgrowing the zone's exp content.
  // Does NOT bypass the minLevel floor. See docs/architecture.md (system zbieractwa).
  allowRevisitAboveLevel Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  monsters             ZoneMonster[]
  drops                ZoneDrop[]
  characters           Character[] @relation("CharacterCurrentZone")
  travelingCharacters  Character[] @relation("CharacterTravelDestination")
  expeditions          Expedition[]
  npcs                 Npc[]
  fishingSpot          FishingSpot?
  mine                 Mine?

  @@index([minLevel, maxLevel])
}

// An NPC in a town zone (see Zone.isTown). "merchant" is the only kind today — sells configured
// items for gold via NpcShopItem.
model Npc {
  id        String   @id @default(cuid())
  zoneId    String
  name      String
  kind      String   @default("merchant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone      Zone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  shopItems NpcShopItem[]

  @@index([zoneId])
}

model NpcShopItem {
  id        String @id @default(cuid())
  npcId     String
  itemId    String
  goldPrice Int
  // null = unlimited stock.
  stock     Int?

  npc  Npc  @relation(fields: [npcId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([npcId, itemId])
}

model Monster {
  id         String   @id @default(cuid())
  name       String
  level      Int
  hp         Int
  stats      String   @default("{}") // JSON: StatBlock
  skills     String   @default("[]") // JSON: MonsterSkill[]
  expReward  Int      @default(0)
  goldReward Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  zones      ZoneMonster[]
  drops      MonsterDrop[]

  @@index([level])
}

model ZoneMonster {
  id           String  @id @default(cuid())
  zoneId       String
  monsterId    String
  spawnWeight  Int     @default(1)
  maxCount     Int     @default(1)

  zone         Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  monster      Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@unique([zoneId, monsterId])
}

model Item {
  id                  String   @id @default(cuid())
  name                String
  type                String
  minLevel            Int      @default(1)
  stackable           Boolean  @default(false)
  maxStack            Int      @default(1)
  description         String   @default("")
  baseStats           String   @default("{}") // JSON: StatBlock — stats at +0
  maxUpgradeStats      String   @default("{}") // JSON: StatBlock — stats at +9, interpolated with baseStats by upgradeLevel
  possibleStatRanges  String   @default("[]") // JSON: StatRange[]
  // Class restriction — null = usable by any class. Only meaningful for weapon/armor/helmet.
  classId             String?
  // Potion behavior — only meaningful when type === "consumable".
  potionTrigger       String? // "hp_below" | "mana_below" | "interval"
  potionThresholdPct  Float?
  potionIntervalSec   Int?
  potionEffect        String? // "restore_hp" | "restore_mana" | "buff_attack_speed" | "buff_attack" | "buff_defense"
  potionMagnitudePct  Float?
  potionDurationSec   Int?
  // Gathering tool bonuses — only meaningful when type === "rod" | "pickaxe". % value AT +9,
  // linearly interpolated from 0 at +0 by (upgradeLevel/9) — see modules/gathering/service.ts.
  // Null = this tool has no bonus of that kind (admin decides per-item, one/both/neither).
  gatherSpeedBonusPctMax  Float?
  gatherChanceBonusPctMax Float?
  // Only meaningful when type === "bait". Flat % bonus to catch/mine chance while carried in an
  // active slot (InventoryItem.activeSlotIndex) — NOT consumed, unlike potions.
  baitChanceBonusPct  Float?
  // Only meaningful when type === "book". Which skill reading this book attempts to level up —
  // exactly one of bookSkillTypeId (passive/gathering skill) or bookClassSkillId (class skill) is
  // set, never both (enforced in CreateItemSchema) — and the chance (0..1) that a read succeeds.
  // See modules/passiveSkills (readBook) and modules/characters (readSkillBook).
  bookSkillTypeId     String?
  bookClassSkillId    String?
  bookSuccessChance   Float?
  // Which axis this book's bonus applies to on success. "magnitude"|"cost"|"cooldown" when
  // bookClassSkillId is set (magnitude = % power, added into skillMagnitudeMultiplier like a
  // node's magnitudePct; cost/cooldown = FLAT amount subtracted after the node %-multiplier
  // already applied — see gatherCombatBuild). "chance"|"speed" when bookSkillTypeId is set
  // (mirrors chanceBonusPerLevel/speedBonusPerLevel, added as CharacterPassiveSkill.bookChanceBonus/
  // bookSpeedBonus). Null = book not yet fully configured.
  bookEffect          String?
  // The book's own fixed bonus amount, as a PERCENTAGE (0..1-ish scale) — used when bookEffect is
  // "magnitude"/"chance"/"speed".
  bookMagnitudePct    Float?
  // The book's own fixed bonus amount, as a FLAT number (e.g. "-3 MP", "-2s") — used when
  // bookEffect is "cost"/"cooldown". Two separate fields because the units genuinely differ; see
  // bookMagnitudePct above for the percentage-based effects.
  bookFlatAmount      Float?
  // Minimum seconds between two read attempts of THIS item (a failed read still starts the
  // cooldown, same as a successful one) — see InventoryItem.lastReadAt. Null = no cooldown.
  bookCooldownSeconds Int?
  // Only meaningful when type === "catalyst" — optional item placed in a free anvil slot
  // (alongside the auto-filled required materials) that adds this flat % to the upgrade's
  // success chance when consumed — see modules/inventory upgradeItem.
  catalystSuccessChanceBonusPct Float?
  // Gold received for selling one unit via the inventory context menu. 0 = not sellable.
  sellPrice           Int      @default(1)
  // Uploaded artwork path (e.g. "/uploads/items/xxx.png"), served statically by the API — see
  // modules/admin/items. Null = fall back to the generic per-type placeholder icon.
  imageUrl            String?
  // How many grid cells this item occupies vertically when placed unequipped (see
  // apps/web/src/lib/inventoryGrid.ts — despite the field name, cells stack downward, not
  // sideways). weapon/armor are seeded at 2; everything else is 1.
  gridWidth           Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  class               CharacterClass? @relation(fields: [classId], references: [id])
  bookSkillType       PassiveSkillType? @relation("BookForPassiveSkill", fields: [bookSkillTypeId], references: [id], onDelete: SetNull)
  bookClassSkill      ClassSkill?       @relation("BookForClassSkill", fields: [bookClassSkillId], references: [id], onDelete: SetNull)
  monsterDrops        MonsterDrop[]
  zoneDrops           ZoneDrop[]
  inventoryItems      InventoryItem[]
  upgradeRequirements ItemUpgradeRequirement[] @relation("ItemUpgradeFor")
  usedInUpgrades      ItemUpgradeRequirement[] @relation("ItemUpgradeMaterial")
  upgradeLevelConfigs ItemUpgradeLevelConfig[]
  chestLootEntries    ChestLoot[] @relation("ChestLootChest")
  chestLootRewards    ChestLoot[] @relation("ChestLootReward")
  starterForClasses   ClassStarterItem[]
  gameEventBonusDrops GameEvent[]
  npcShopEntries      NpcShopItem[]
  fishingDrops        FishingDrop[] @relation("FishingDropItem")
  miningDrops         MiningDrop[]  @relation("MiningDropItem")

  @@index([classId])

  @@index([type])
}

model ItemUpgradeRequirement {
  id              String @id @default(cuid())
  itemId          String
  targetLevel     Int
  requiredItemId  String
  requiredQty     Int

  item            Item   @relation("ItemUpgradeFor", fields: [itemId], references: [id], onDelete: Cascade)
  requiredItem    Item   @relation("ItemUpgradeMaterial", fields: [requiredItemId], references: [id])

  @@unique([itemId, targetLevel, requiredItemId])
}

// Optional per-(item, targetLevel) override of the upgrade success chance shown/used by the
// Kowadło (anvil) tab. No row for a given targetLevel = the shared default decreasing curve
// applies (packages/shared/src/lib/upgradeSuccess.ts), used identically by server and client.
model ItemUpgradeLevelConfig {
  id             String @id @default(cuid())
  itemId         String
  targetLevel    Int
  successChance  Float
  // Gold cost to attempt this upgrade. null = use the shared default increasing curve
  // (packages/shared/src/lib/upgradeSuccess.ts's defaultUpgradeGoldCost), same override pattern
  // as successChance.
  goldCost       Int?

  item           Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, targetLevel])
}

// Chest contents — only meaningful when the owning Item.type === "chest". Rolled independently
// per row when the chest is opened (modules/inventory/service.ts, openChest).
model ChestLoot {
  id           String @id @default(cuid())
  chestItemId  String
  rewardItemId String
  dropChance   Float
  minQty       Int    @default(1)
  maxQty       Int    @default(1)

  chestItem    Item   @relation("ChestLootChest", fields: [chestItemId], references: [id], onDelete: Cascade)
  rewardItem   Item   @relation("ChestLootReward", fields: [rewardItemId], references: [id])

  @@unique([chestItemId, rewardItemId])
  @@index([chestItemId])
}

// Items granted once, automatically, when a character of this class is created — see
// docs/architecture.md.
model ClassStarterItem {
  id       String @id @default(cuid())
  classId  String
  itemId   String
  quantity Int    @default(1)

  class    CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  item     Item           @relation(fields: [itemId], references: [id])

  @@unique([classId, itemId])
  @@index([classId])
}

model MonsterDrop {
  id          String  @id @default(cuid())
  monsterId   String
  itemId      String
  dropChance  Float
  minQty      Int     @default(1)
  maxQty      Int     @default(1)

  monster     Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  item        Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([monsterId, itemId])
}

model ZoneDrop {
  id          String @id @default(cuid())
  zoneId      String
  itemId      String
  dropChance  Float

  zone        Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([zoneId, itemId])
}

model InventoryItem {
  id            String   @id @default(cuid())
  characterId   String
  itemId        String
  // Grid position — null while the item is equipped or sitting in an active potion slot (freed on
  // equip/set-active, reassigned via findNextFreeSlotIndex on unequip/clear — see
  // modules/inventory/service.ts). Nullable so multiple equipped/active items can coexist without
  // colliding on @@unique([characterId, slotIndex]) (SQL treats each NULL as distinct).
  slotIndex     Int?
  quantity      Int      @default(1)
  rolledStats   String   @default("{}") // JSON: StatBlock
  upgradeLevel  Int      @default(0)
  equippedSlot  String?
  activeSlotIndex Int?
  // Player-set override of Item.potionThresholdPct for THIS specific inventory stack — lets the
  // player pick "use below 30% HP" per active slot instead of always the admin's item-wide
  // default. Only meaningful when Item.potionTrigger is "hp_below"/"mana_below"; ignored (and not
  // settable) for "interval"-triggered potions since there's no threshold to override. Null =
  // use the item's own default (see gatherCombatBuild in expeditions/service.ts).
  potionThresholdOverridePct Float?
  // Only meaningful for type rod/pickaxe: successful gathers performed with THIS specific tool
  // instance since its last upgrade. Gates the anvil upgrade past
  // gathering.settings.successesPerToolUpgrade (see modules/inventory/service.ts upgradeItem) and
  // resets to 0 on a successful upgrade.
  gatherSuccessCount Int @default(0)
  // Only meaningful for type "book" — set to now() on EVERY read attempt (success or failure both
  // count), compared against Item.bookCooldownSeconds. Null = never read yet / no cooldown.
  lastReadAt DateTime?
  // Only meaningful for type "book" — a one-shot success-chance bonus (0..1) from a
  // "boost_next_book_chance" consumable, added to Item.bookSuccessChance on the NEXT read attempt
  // of this stack, then cleared regardless of the roll's outcome. See modules/inventory useBuffItem.
  nextReadBonusPct Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item          Item      @relation(fields: [itemId], references: [id])

  @@unique([characterId, slotIndex])
  @@unique([characterId, activeSlotIndex])
  @@index([characterId])
}

model Expedition {
  id          String   @id @default(cuid())
  characterId String
  zoneId      String
  status      String   @default("in_progress")
  startedAt   DateTime @default(now()) // departs the village
  arrivedAt   DateTime // travel-there complete, combat begins
  fightEndsAt DateTime // combat simulation complete, travel-back begins
  endsAt      DateTime // travel-back complete, rewards claimable
  result      String? // JSON: ExpeditionResult, computed server-side at start
  eventLog    String? // JSON: CombatEvent[], computed server-side at start, revealed progressively client-side
  // Monster ids (subset of the zone's pool) the player chose to fight — see docs/architecture.md
  // "Etap 9". Empty array = whole zone pool, preserving pre-Etap-9 behavior.
  selectedMonsterIds String @default("[]")
  // Set by the admin "revert expedition" tool when a claimed/left-early expedition's rewards
  // were undone (e.g. a balance exploit). Null = never reverted. See docs/architecture.md.
  revertedAt DateTime?
  // Exp/gold multiplier from any GameEvent active at simulation time — baked in here (rather
  // than re-read live at claim time) so the reward math and the SUSPICIOUS_LEVEL_JUMP safety
  // threshold stay consistent even if the event has since ended. 1 = no event active.
  appliedExpMultiplier  Float @default(1)
  appliedGoldMultiplier Float @default(1)
  // JSON: {slotIndex, itemId, quantity}[] — snapshot of the character's active item slots at the
  // moment the fight was simulated. The whole fight (incl. potion consumption) is computed and
  // applied atomically at start (see startExpedition), so live inventory already reflects the
  // post-fight state for the entire time the "w toku" screen is open — this snapshot is what lets
  // that screen still show what was actually equipped for THIS fight instead of an already-empty
  // active slot. Default "[]" so expeditions in flight at deploy time keep working unmodified.
  potionSlotsSnapshot String @default("[]")

  character   Character @relation("CharacterExpeditions", fields: [characterId], references: [id], onDelete: Cascade)
  zone        Zone      @relation(fields: [zoneId], references: [id])

  @@index([characterId, status])
}

// Time-boxed exp/gold multiplier, configured by an admin (see docs/architecture.md "Etap 16").
// "Active" = startsAt <= now <= endsAt; overlapping active events combine by taking the max of
// each multiplier independently (not multiplying together) to avoid accidental stacking.
model GameEvent {
  id             String   @id @default(cuid())
  name           String
  expMultiplier  Float    @default(1)
  goldMultiplier Float    @default(1)
  startsAt       DateTime
  endsAt         DateTime
  // Optional: one item that drops from EVERY zone (independently of that zone's own drop
  // table) while this event is active — e.g. a limited-time "event chest" without having to
  // add it to every zone by hand. null itemId / 0 chance = no bonus drop configured.
  bonusDropItemId String?
  bonusDropChance Float?  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bonusDropItem  Item?    @relation(fields: [bonusDropItemId], references: [id])

  @@index([startsAt, endsAt])
}

model GameLog {
  id                String   @id @default(cuid())
  module            String
  level             String   @default("info")
  action            String
  actorUserId       String?
  actorCharacterId  String?
  payload           String   @default("{}") // JSON
  requestId         String?
  createdAt         DateTime @default(now())

  actorUser         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([level])
  @@index([createdAt])
  @@index([actorUserId])
}

model Settings {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// Zbieractwo (system łowisk i kopalni) — patrz docs/architecture.md. Mirror wzorca isTown/Npc:
// opcjonalna funkcja krainy (0 lub 1 wiersz na Zone), pokrywa zarówno "łowisko w istniejącej
// krainie" jak i "kraina wyłącznie z łowiskiem" (bez przypisanych ZoneMonster).
model FishingSpot {
  id              String   @id @default(cuid())
  zoneId          String   @unique
  name            String   @default("Łowisko")
  // null = fallback do Settings "gathering.settings" (fishing min/max).
  minCatchSeconds Int?
  maxCatchSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  zone     Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  drops    FishingDrop[]
  sessions GatherSession[] @relation("GatherFishingSpot")
}

model FishingDrop {
  id            String @id @default(cuid())
  fishingSpotId String
  itemId        String
  dropChance    Float
  minQty        Int    @default(1)
  maxQty        Int    @default(1)

  fishingSpot FishingSpot @relation(fields: [fishingSpotId], references: [id], onDelete: Cascade)
  item        Item        @relation("FishingDropItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([fishingSpotId, itemId])
}

model Mine {
  id                String   @id @default(cuid())
  zoneId            String   @unique
  name              String   @default("Kopalnia")
  // null = fallback do Settings "gathering.settings" (miningExtract/miningSearch min/max).
  minExtractSeconds Int?
  maxExtractSeconds Int?
  minSearchSeconds  Int?
  maxSearchSeconds  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  zone     Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  drops    MiningDrop[]
  sessions GatherSession[] @relation("GatherMine")
}

model MiningDrop {
  id         String @id @default(cuid())
  mineId     String
  itemId     String
  dropChance Float
  minQty     Int    @default(1)
  maxQty     Int    @default(1)

  mine Mine @relation(fields: [mineId], references: [id], onDelete: Cascade)
  item Item @relation("MiningDropItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([mineId, itemId])
}

// Jedna aktywna sesja zbieractwa na postać (characterId @unique — mirror Character.activeExpeditionId
// uniqueness). Nagroda przyznawana natychmiast po rozwiązaniu każdej fazy (nie batch na końcu jak
// Expedition), więc nie ma potrzeby "częściowej nagrody przy wcześniejszym wyjściu" jak w ekspedycjach.
// Valid values kind: fishing | mining. Valid values phase: catching | extracting | searching.
model GatherSession {
  id            String   @id @default(cuid())
  characterId   String   @unique
  kind          String
  fishingSpotId String?
  mineId        String?
  phase         String
  phaseEndsAt   DateTime
  totalGathered Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  fishingSpot FishingSpot? @relation("GatherFishingSpot", fields: [fishingSpotId], references: [id], onDelete: Cascade)
  mine        Mine?        @relation("GatherMine", fields: [mineId], references: [id], onDelete: Cascade)
}

// Prywatna wiadomość między dwoma kontami (nie postaciami — jak FriendRequest, adresowana przez
// nazwę postaci przy wysyłce, ale relacja żyje na poziomie User). Usuwanie miękkie: każda strona
// ma własną flagę "deletedBy*", więc usunięcie przez jedną stronę nie zabiera wiadomości drugiej.
model Message {
  id                 String   @id @default(cuid())
  senderId           String
  recipientId        String
  subject            String
  body               String
  read               Boolean  @default(false)
  deletedBySender    Boolean  @default(false)
  deletedByRecipient Boolean  @default(false)
  createdAt          DateTime @default(now())

  sender    User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([senderId])
}

// Zgłoszenie do administracji (bug, pytanie itd.) — treść startowa w samym tickecie, dalsza
// wymiana w SupportTicketReply. Valid values status: open | in_progress | resolved | closed.
model SupportTicket {
  id           String   @id @default(cuid())
  authorUserId String
  subject      String
  body         String
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author  User                 @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  replies SupportTicketReply[]

  @@index([authorUserId])
  @@index([status])
}

model SupportTicketReply {
  id           String   @id @default(cuid())
  ticketId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Wpis changelogu — wyłącznie ręcznie dodawany przez admina przez panel (patrz docs/architecture.md),
// nie ma tu żadnej automatyzacji z commitów gita.
model ChangelogEntry {
  id           String   @id @default(cuid())
  title        String
  body         String
  authorUserId String
  createdAt    DateTime @default(now())

  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
}
